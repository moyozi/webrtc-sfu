[Unit]
Description=webrtc-sfu server
Documentation=https://example.invalid/webrtc-sfu
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 环境变量（见 deploy/sfu.env.example）
EnvironmentFile=/etc/sfu/sfu.env
# 二进制路径（按实际部署调整）
ExecStart=/opt/sfu/sfu-server
WorkingDirectory=/opt/sfu
Restart=on-failure
RestartSec=2
# 高并发连接需要较大 fd 上限
LimitNOFILE=524288
# 可选的调度优先级（按需启用）
# Nice=-5
# CPUAffinity=0-7
# 说明：内核网络参数请单独执行 scripts/sysctl-sfu.sh（需要 root，且开机持久化）

[Install]
WantedBy=multi-user.target
