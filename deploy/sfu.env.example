# webrtc-sfu 环境变量配置示例
# 复制到 /etc/sfu/sfu.env 后按需修改（供 systemd EnvironmentFile 使用）

# ── 必填 ─────────────────────────────────────────────
# 对外通告 IP：写入 SDP/ICE host 候选，必须是客户端可达的本机地址
SFU_ANNOUNCE_IP=192.168.1.10
# worker 线程数（= 媒体端口数，建议 ≤ 物理核数）
SFU_WORKERS=4
# 可选：强制未配置房间全落该 worker；不设则按房间 id 哈希固定到单个 worker。
# SFU_DEFAULT_WORKER=0
# 房间级分片（可选）：房间 -> 全局 worker 列表；分号分隔多条规则。
# 缺省时按房间 id 哈希固定到单个 worker（同房间同 worker，不同房间自动分散）。
# 单房间要跨 worker（单机多 worker / 多主机多 worker）需在这里显式配置。
#   单 worker 钉定: roomA=3
#   房间内轮转:   roomB=0,1,2,3
#   兑底规则:     *=0,1,2,3
# SFU_ROOM_WORKERS="roomB=0,1,2,3;*=0"

# ── 监听地址（默认全部 0.0.0.0）──────────────────────
SFU_WS_ADDR=0.0.0.0:5174
SFU_MEDIA_ADDR=0.0.0.0:5175
# QUIC 信令；设为 0/off/空 则禁用
SFU_QUIC_ADDR=0.0.0.0:5173
# WHIP 推流接入（FFmpeg/GStreamer/OBS）；不需要则整行删除
SFU_WHIP_ADDR=0.0.0.0:5180
# WHEP 拉流接入（浏览器/播放器）；不需要则整行删除
SFU_WHEP_ADDR=0.0.0.0:5181

# ── 调优（可选）─────────────────────────────────────
SFU_SOCK_BUF_MB=16
SFU_BWE_INITIAL_BPS=1000000
# 收包/等待 I/O 后端：auto=支持则用 io_uring(内核 5.11+)，否则回退 epoll；
# on=强制 io_uring(不可用则启动失败)；off=始终 epoll+recvmmsg。
SFU_IO_URING=auto
# 批量参数 (上限均为 256)。高 fan-out 可适当调大以提升突发吸收能力。
# SFU_BATCH_SIZE=64
# SFU_SEND_BATCH=128
# 发送队列积压上限 (超限丢最旧包)；默认 8192，高 fan-out 可调到 65536。
# SFU_SEND_BACKLOG=8192

# ── 内嵌信令分配器（可选；客户端统一先请求分配器拿信令地址）──
# 开启后本进程在后台线程再跑一个分配器，单机也推荐开启，客户端逻辑统一。
# SFU_DISPATCHER_ADDR=0.0.0.0:5190
# SFU_DISPATCHER_COHOST=on
# 信令机清单：只有本机时写本机的 ws:quic:whip:whep（端口 0 = 禁用）
# SFU_SIGNALING_NODES="self@192.168.1.10:5174:5173:5180:5181"

# ── JWT 用户鉴权（可选；不配置则关闭）─────────────────
# 配置任一密钥后默认强制所有 join 携带有效 token。
# SFU_JWT_SECRET=<强随机密钥>
# 不配置任何密钥时鉴权整体关闭 (测试期保持注释即可)。
# 或使用非对称公钥（RS/ES/EdDSA）:
# SFU_JWT_PUBLIC_KEY_FILE=/etc/sfu/jwt-pub.pem
# SFU_JWT_ALGORITHM=RS256
# SFU_JWT_ISSUER=https://idp.example.com
# SFU_JWT_AUDIENCE=webrtc-sfu
# SFU_JWT_REQUIRED=on

RUST_LOG=info
