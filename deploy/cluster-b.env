# 跨主机集群示例 — Host B（10.0.0.2）：worker-only + worker 2,3
# 不跑信令；媒体端口与 announce 为本机。

SFU_SIGNALING=off
SFU_ANNOUNCE_IP=10.0.0.2
SFU_WORKERS=2
SFU_TOTAL_WORKERS=4
SFU_WORKER_OFFSET=2

SFU_MEDIA_ADDR=0.0.0.0:5175
# 关闭信令端口（worker-only 不会监听，但显式关闭可避免误配）
SFU_QUIC_ADDR=0
SFU_WS_ADDR=0.0.0.0:5174

# 控制面：接收 Host A 的命令
SFU_CONTROL_LISTEN=0.0.0.0:5401
SFU_CONTROL_PEERS=0=10.0.0.1:5400,1=10.0.0.1:5400

# 媒体中继：指向 Host A 的 relay
SFU_RELAY_LISTEN=0.0.0.0:5391
SFU_RELAY_PEERS=0=10.0.0.1:5390,1=10.0.0.1:5390

SFU_SOCK_BUF_MB=16
RUST_LOG=info
