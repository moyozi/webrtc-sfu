# 信令分配器 (Signaling Dispatcher) 环境变量示例
# 复制到 /etc/sfu/dispatcher.env 后按需修改（供 systemd EnvironmentFile 使用）
#
# 分配器与 SFU 服务是同一个二进制 sfu-server：只要设置了 SFU_DISPATCHER_ADDR，
# 本进程就只运行分配器，不再启动 worker / 信令服务器。
# 详见 docs/signaling-dispatcher.md

# ── 必填 ─────────────────────────────────────────────
# 分配器 HTTP 监听地址（前置 VIP/LB 时对客户端暴露）
SFU_DISPATCHER_ADDR=0.0.0.0:5190

# 信令机清单: id@host:ws:quic:whip:whep[:weight];...
#   端口 0 = 该入口禁用; weight 可选, 默认 1, 越大分到的房间越多。
SFU_SIGNALING_NODES=cell-a@10.0.0.1:5174:5173:5180:5181;cell-b@10.0.0.2:5174:5173:5180:5181

# ── 健康检查（可选）─────────────────────────────────
# 健康检查周期（秒，最小 1）
SFU_DISPATCHER_HEALTH_INTERVAL_SECS=5
# 单次 TCP 连接探测超时（毫秒，最小 50）
SFU_DISPATCHER_HEALTH_TIMEOUT_MS=1000

RUST_LOG=info
