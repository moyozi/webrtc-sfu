# 纯信令节点示例 — 不跑任何 worker, 媒体全部在远端媒体机。
#
# 角色: SFU_SIGNALING=on + SFU_WORKERS=0
#   · 只维护房间内存态, 跑 WS / QUIC / WHIP / WHEP;
#   · 不创建 worker 线程, 不绑定媒体 UDP / 跨主机 relay 端口;
#   · 所有房间命令经 gRPC (SFU_CONTROL_PEERS) 下发到远端媒体机。
#
# 必要约束 (否则进程启动即退出):
#   · 必须配置 SFU_TOTAL_WORKERS (整集群 worker 总数);
#   · 必须配置 SFU_CONTROL_PEERS (指向所有远端媒体机 worker)。
# 媒体机侧对应配置见 cluster-b.env 的 SFU_CONTROL_LISTEN。

SFU_SIGNALING=on
SFU_WORKERS=0

# 整集群 worker 总数 (全局编号 0..total), 需与各媒体机拓扑一致
SFU_TOTAL_WORKERS=4

# 远端媒体机的 MediaControl gRPC 地址 (全局 worker -> 地址)
# 例如 worker 0..3 都在 10.0.0.2 的媒体机上:
SFU_CONTROL_PEERS=0=10.0.0.2:5400,1=10.0.0.2:5400,2=10.0.0.2:5400,3=10.0.0.2:5400

# 房间级分片 (可选, 需与所有信令机/媒体机保持一致)
# SFU_ROOM_WORKERS=load=0,1,2,3

# 信令入口
SFU_WS_ADDR=0.0.0.0:5174
SFU_QUIC_ADDR=0.0.0.0:5173
# WHIP/WHEP (可选)
# SFU_WHIP_ADDR=0.0.0.0:5180
# SFU_WHEP_ADDR=0.0.0.0:5181

# 注意: 纯信令节点无需 SFU_ANNOUNCE_IP / SFU_MEDIA_ADDR / SFU_RELAY_*
# (媒体候选与中继地址由远端媒体机自己写入)。

# JWT 用户鉴权 (仅信令节点需要)
# SFU_JWT_SECRET=<强随机密钥>
# SFU_JWT_REQUIRED=on

RUST_LOG=info
